<Window x:Class="VRCapabilityChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VR Capability Checker" Height="700" Width="900"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="VR Capability Checker"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Check if your system meets high-end VR requirements"
                       FontSize="14"
                       Foreground="{StaticResource TextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"
                       Opacity="0.7"/>
        </StackPanel>

        <!-- Scan Button -->
        <Button Grid.Row="1"
                x:Name="ScanButton"
                Content="Scan System"
                Height="50"
                FontSize="18"
                FontWeight="Bold"
                Background="{StaticResource PrimaryBrush}"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="ScanButton_Click"
                Margin="0,0,0,20">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="5"
                                        Padding="20,10">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1976D2"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Results Area -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Background="{StaticResource SurfaceBrush}"
                      Padding="15"
                      Margin="0,0,0,20">
            <StackPanel x:Name="ResultsPanel">
                <TextBlock Text="Click 'Scan System' to check VR readiness"
                          FontSize="16"
                          Foreground="{StaticResource TextBrush}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Opacity="0.5"
                          Margin="0,100,0,0"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Overall Status -->
        <Border Grid.Row="3"
                x:Name="StatusBorder"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="5"
                Padding="20"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                          FontSize="20"
                          FontWeight="Bold"
                          HorizontalAlignment="Center"/>
                <TextBlock x:Name="StatusDetails"
                          FontSize="14"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"
                          Opacity="0.8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
