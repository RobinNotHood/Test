<Window x:Class="VRCapabilityChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VR Capability Checker" Height="800" Width="1100"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="VR Capability Checker"
                       FontSize="32"
                       FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Check if your system meets high-end VR requirements"
                       FontSize="14"
                       Foreground="{StaticResource TextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"
                       Opacity="0.7"/>
        </StackPanel>

        <!-- Scan Button -->
        <Button Grid.Row="1"
                x:Name="ScanButton"
                Content="Scan System"
                Height="50"
                FontSize="18"
                FontWeight="Bold"
                Background="{StaticResource PrimaryBrush}"
                Foreground="White"
                BorderThickness="0"
                Cursor="Hand"
                Click="ScanButton_Click"
                Margin="0,0,0,20">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="5"
                                        Padding="20,10">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#1976D2"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Results Area with Tabs -->
        <TabControl Grid.Row="2"
                    x:Name="ResultsTabs"
                    Margin="0,0,0,20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderThickness="0"
                    Visibility="Collapsed">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Border"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderThickness="0"
                                        CornerRadius="5,5,0,0"
                                        Padding="15,10"
                                        Margin="0,0,5,0">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="#1976D2"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="FontSize" Value="14"/>
                </Style>
            </TabControl.Resources>

            <!-- System Information Tab -->
            <TabItem Header="System Info">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel x:Name="SystemInfoPanel"/>
                </ScrollViewer>
            </TabItem>

            <!-- VR Headset Compatibility Tab -->
            <TabItem Header="VR Headset Compatibility">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel x:Name="VRCompatibilityPanel"/>
                </ScrollViewer>
            </TabItem>

            <!-- FPS Estimates Tab -->
            <TabItem Header="Expected FPS in VR Games">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="15">
                    <StackPanel x:Name="FPSEstimatesPanel"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Initial Message -->
        <Border Grid.Row="2"
                x:Name="InitialMessage"
                Background="{StaticResource SurfaceBrush}"
                Margin="0,0,0,20">
            <TextBlock Text="Click 'Scan System' to check VR readiness"
                      FontSize="16"
                      Foreground="{StaticResource TextBrush}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Opacity="0.5"
                      Margin="0,200,0,0"/>
        </Border>

        <!-- Overall Status -->
        <Border Grid.Row="3"
                x:Name="StatusBorder"
                Background="{StaticResource SurfaceBrush}"
                CornerRadius="5"
                Padding="20"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="StatusText"
                          FontSize="20"
                          FontWeight="Bold"
                          HorizontalAlignment="Center"/>
                <TextBlock x:Name="StatusDetails"
                          FontSize="14"
                          HorizontalAlignment="Center"
                          Margin="0,5,0,0"
                          Opacity="0.8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
